# Contra — copy to .env and fill in your keys
#
# LLM provider: groq | anthropic | openai
# When the primary hits a rate-limit (429), auto-switches to the next configured provider.
#
# Free:  Groq — https://console.groq.com  (100k tokens/day on 70b, 500k/day on 8b)
# Paid:  OpenAI gpt-4o-mini  ~$0.15/1M tokens  https://platform.openai.com
# Paid:  Anthropic claude-3-5-haiku  ~$0.80/1M tokens  https://console.anthropic.com

PULSE_LLM_PROVIDER=anthropic
GROQ_API_KEY=

# Anthropic — Claude Haiku is the default gate verdict model when this key is set
# (CLAUDE_API_KEY is accepted as an alias)
ANTHROPIC_API_KEY=

# Optional: force gate verdict + chat to Haiku explicitly
# GATE_LLM_PROVIDER=anthropic
# GATE_LLM_MODEL=claude-3-5-haiku-20241022

# Optional paid fallbacks (add keys to enable auto-rotation)
# OPENAI_API_KEY=

# Auto-switch to next provider on rate-limit (429) or context-size (413)
PULSE_LLM_AUTO_SWITCH=true

# Web search — Claude built-in web_search (same ANTHROPIC_API_KEY). No Tavily required.
# Options: anthropic | auto | openai | tavily
#   anthropic → Claude web_search_20250305 (recommended)
#   auto      → anthropic → openai → tavily
#   tavily    → optional; only if TAVILY_API_KEY is set
PULSE_SEARCH_PROVIDER=anthropic
# TAVILY_API_KEY=
# Every search is written to MotherDuck table web_search_log (GET /api/prospector/search-log)

# Cloud DuckDB (required on Render — local disk is ephemeral)
# MOTHERDUCK_TOKEN=

# Prospector — autonomous LP mining agent
# Leave false in production unless you intentionally want scheduled mining (API cost).
PROSPECTOR_AUTORUN=false
# PROSPECTOR_INTERVAL_HOURS=24
# PROSPECTOR_MAX_SEEDS=5
# PROSPECTOR_MAX_QUERIES=10
# PROSPECTOR_MAX_CANDIDATES=12
# PROSPECTOR_MAX_GATE=6
# Wall-clock abort (seconds) — stops the cascade between stages when exceeded.
# PROSPECTOR_MAX_RUNTIME_SEC=600
# Per-run / daily estimated-USD ceilings (0 disables). See GET /api/prospector/costs
# PROSPECTOR_MAX_RUN_COST_USD=3
# PROSPECTOR_MAX_DAILY_COST_USD=8
# PROSPECTOR_MAX_RUNS_PER_DAY=4
# Pause scheduled mining after N consecutive completed runs with promoted=0
# PROSPECTOR_ZERO_YIELD_PAUSE=3
# Optional unit prices for the cost estimate (not invoices)
# PROSPECTOR_COST_SEARCH_USD=0.008
# PROSPECTOR_COST_LLM_USD=0.03
# PROSPECTOR_COST_FETCH_USD=0.001
# PROSPECTOR_COST_GATE_USD=0.25
# PAST_OUTREACH_DIR=                 # path to the .eml archive (default: ../past_outreach)

# Console login — REQUIRED in production (leave unset only for local dev)
# CONSOLE_PASSWORD=
# CONSOLE_TOKEN_HOURS=168

# CORS — comma-separated frontend origins (Vercel URL in production)
# ALLOWED_ORIGINS=https://your-app.vercel.app
# Disable localhost regex in production:
# CORS_DEV_REGEX=0

# NFX Signal scraper credentials — https://signal.nfx.com
NFX_USERNAME=
NFX_PASSWORD=

# Phantombuster — optional LinkedIn enrichment (modules not shipped in this build)
# PHANTOMBUSTER_API_KEY=
# PHANTOMBUSTER_AGENT_ID=
# PHANTOMBUSTER_PROFILE_AGENT_ID=
# PHANTOMBUSTER_TIMEOUT_SEC=3600

# Optional Airtable CRM sync
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
